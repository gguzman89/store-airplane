generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["views"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(255)
  content   String?
  published Boolean  @default(false)
  authorId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id])

  @@map("posts")
}

model Profile {
  id     Int     @id @default(autoincrement())
  bio    String?
  userId Int     @unique
  user   User    @relation(fields: [userId], references: [id])

  @@map("profiles")
}

model User {
  id      Int      @id @default(autoincrement())
  email   String   @unique
  name    String?
  posts   Post[]
  profile Profile?

  @@map("users")
}

model Stock {
  id        Int       @id @default(autoincrement())
  empresa   Int
  sucursal  Int
  articulo  Int
  cantidad  Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  reservas  Reserva[]

  @@map("stock")
}

model Reserva {
  id        Int           @id @default(autoincrement())
  empresa   Int
  sucursal  Int
  articulo  Int
  cantidad  Int
  estado    EstadoReserva @default(PENDIENTE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  stockId   Int
  stock     Stock         @relation(fields: [stockId], references: [id])

  @@map("reservas")
}

model movimiento {
  id             Int            @id @default(autoincrement())
  empresa        Int
  sucursal       Int
  articulo       Int
  cantidad       Int
  descripcion    String?
  comentario     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  codOperacion   Int?
  precioUnitario Int?
  tipo           TipoMovimiento

  @@map("movimientos")
}

model MovimientoTmp {
  id             Int            @id @default(autoincrement())
  empresa        Int
  sucursal       Int
  articulo       Int
  cantidad       Int
  descripcion    String?  // limit 255
  tipo           TipoMovimiento @default(MERCADERIA_TEMPORAL)
  comentario     String?  // limit 255
  codOperacion   Int?
  precioUnitario Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  transactionId  String

  @@map("temporary_movimientos")
}

view stock_disponible {
  empresa          Int?
  sucursal         Int?
  articulo         Int?
  saldo_disponible BigInt?
}

enum EstadoReserva {
  PENDIENTE
  COMPLETADA
  CANCELADA

  @@map("EstadosReserva")
}

enum TipoMovimiento {
  MERCADERIA_INGRESO  @map("MERCADERIA")
  ANULACION
  VENTAS
  MERCADERIA_EGRESO
  MERCADERIA_TEMPORAL

  @@map("Categorias")
}
